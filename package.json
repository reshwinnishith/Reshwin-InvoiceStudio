{
  "name": "reshwin-invoice-studio",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "check": "node --check app.js && node --check pdf.js && node --check core.js && node --check cloud.mjs && node --check boot.mjs && node --check tests/smoke.cjs",
    "test:unit": "node tests/core.test.cjs && node tests/smoke.cjs",
    "test:emulator": "node scripts/run-emulator-tests.mjs",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-invoice-studio-v2 \"node tests/e2e/browser.e2e.mjs\"",
    "test": "npm run check && npm run test:unit && npm run test:emulator"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "playwright-core": "^1.49.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
